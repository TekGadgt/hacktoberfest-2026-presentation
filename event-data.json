    {
      "time": "1:00 PM",
      "title": "Teach it to choose: Build your own decision model",
      "description": "A practical workshop using open-weight language models.",
      "presenter": "Chazona Baum"
    },
    {
      "time": "1:30 PM",
      "title": "Meet Your New Sidekick: Hands-On with Hermes Agent",
      "description": "Build and experiment with an open-source agent.",
      "presenter": "Lee Talley"
    }
  ],
  "challenges": [
    {
      "name": "Best Open-Source AI Project",
      "kind": "Official Hacktoberfest challenge",
      "summary": "Build an original project where open-source or open-weight AI does important work.",
      "requirements": [
        "Publish the project in a public GitHub repository",
        "Include an open-source license",
        "Follow the Agent Skill Open Standard when submitting an agent skill"
      ],
      "prize": "Winner DEV Badge and MLH swag bag for the winning team"
    },
    {
      "name": "Best Use of Gemma 4",
      "kind": "Partner challenge",
      "summary": "Build a focused multimodal tool with an open-weights model through the Gemini API.",
      "requirements": [
        "Use Gemma 4 as an important part of the project",
        "Show a working experience with text, images, or both"
      ],
      "prize": "See the live challenge page for current prize details"
    },
    {
      "name": "Gloriously Overengineered",
      "kind": "Local challenge",
      "summary": "Use serious AI engineering to solve a delightfully tiny problem.",
      "requirements": [
        "AI must do real work",
        "The demo must show how the system works",
        "The project should work live and commit to the bit"
      ],
      "prize": "One-month 757 Makerspace memberships for up to three winning team members"
    },
    {
      "name": "Best AI Security Project",
      "kind": "Local challenge",
      "summary": "Use AI to protect people or make AI systems harder to misuse.",
      "requirements": [
        "Address a specific security problem",
        "Test only systems you own or have permission to test",
        "Show the problem and the project response"
      ],
      "prize": "The AI Cybersecurity Handbook and Software Transparency"
    },
    {
      "name": "Best Community Impact Project",
      "kind": "Local challenge",
      "summary": "Build for a specific community and a problem that people already face.",
      "requirements": [
        "Name the community and the problem",
        "Handle personal data responsibly",
        "Demo a realistic scenario from the user perspective"
      ],
      "prize": "Our Planet Powered by AI and The Equality Machine"
    }
  ],
